# Language
language = en

# Spacing
window-padding-x = 10
window-padding-y = 2

# Cursor
cursor-style = block
cursor-style-blink = false

# Font
font-family = ""
font-family = "AdwaitaMono Nerd Font Mono"
font-size = 12

# Themes
theme = Kanagawa Wave
background-opacity = 1.0
background-blur = true

# Screen/Window
maximize
fullscreen = true
title = ""

# notifications
bell-features = "no-audio, no-system, no-attention, title, border"

# shell integrations
shell-integration = detect
shell-integration-features = no-cursor
